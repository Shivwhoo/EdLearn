# EdLearn backend — environment variable reference.
# Copy to .env and fill in real values. Never commit a filled-in .env file.
# This file documents variable NAMES only — no real secrets belong here.

# --- Core ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# --- Databases ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/edlearn?schema=public
MONGODB_URI=mongodb://localhost:27017/edlearn
REDIS_URL=redis://localhost:6379

# --- Auth ---
JWT_SECRET=
SSO_SHARED_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# --- AI providers ---
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# --- Media/TTS storage (M2) ---
# STORAGE_PROVIDER=local (default) writes to backend/tts-audio/ on disk.
# STORAGE_PROVIDER=s3 persists to S3 or an S3-compatible bucket (Cloudflare
# R2, MinIO, etc.) — required for correctness with more than one backend
# replica. See backend/src/lib/storage/s3-storage.ts for full details.
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_URL_BASE=

# --- Observability (M2) ---
# Sentry error monitoring. Leave SENTRY_DSN unset to disable Sentry entirely
# (safe default for local dev).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Structured logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

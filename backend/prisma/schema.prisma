generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  profile       UserProfile?
  roadmaps      Roadmap[]
  progress      Progress[]
  credits       Int           @default(15)
  subscription  Subscription?
  workspace     Workspace?
  badges Badge[]
  visions       Vision[]
}

/// A single card on a student's personal Vision Board — a learning goal,
/// career ambition or aspiration they want to keep in front of them.
/// Always scoped to one owner; the API never trusts a client-supplied userId.
model Vision {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?  @db.Text
  category    String   @default("other") // "education" | "career" | "skills" | "achievements" | "growth" | "projects" | "other"
  imageUrl    String?  @db.Text          // remote https URL or a compact client-downscaled data URL
  targetDate  DateTime?
  quote       String?                    // short motivational line shown on the card
  resourceUrl String?                    // optional link to a course, job posting, article...
  status      String   @default("not_started") // "not_started" | "in_progress" | "achieved"
  achievedAt  DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, status])
}

model Badge {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  description String?
  badgeType   String
  imageUrl    String?

  earnedAt    DateTime @default(now())

}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String?
  careerGoal    String?
  currentSkills String[]
  availableTime Int
  difficulty    String   @default("Intermediate")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id           String   @id @default(uuid())
  userId       String
  title        String
  deadline     DateTime
  isAchievable Boolean  @default(true)
  createdAt    DateTime @default(now())
  days         Day[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Day {
  id        String  @id @default(uuid())
  roadmapId String
  dayNumber Int
  title     String
  duration  Int
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id          String     @id @default(uuid())
  dayId       String
  title       String
  mode        Int
  notesHtml   String
  audioUrl    String?
  audioTiming Json?
  completed   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  citations   Citation[]
  day         Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Citation {
  id        String  @id @default(uuid())
  topicId   String
  label     String
  rawText   String
  sourceUrl String?
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(uuid())

  userId      String
  roadmapId   String
  dayId       String

  score       Int      @default(100)
  completedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  stripeId  String   @unique
  status    String
  tier      String   @default("FREE")
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  source      String
  url         String   @unique
  imageUrl    String?
  category    String   // "tech", "finance", "world", "medical", "science", "education"
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

model MediaContent {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  thumbnailUrl String
  contentUrl   String   @unique // YouTube URL or MP3 audio URL
  contentType  String   // "video" or "audio"
  platform     String   // "youtube", "podcastindex"
  channelName  String
  duration     Int?     // In seconds
  publishedAt  DateTime
  category     String   // "business", "science", "history", "health", "tech", "culture"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([contentType])
  @@index([publishedAt])
}

model BookSummary {
  id                    String   @id @default(cuid())
  title                 String
  author                String
  coverImage            String
  description           String   @db.Text
  threeSentenceTakeaway String   @db.Text
  genre                 String   // "business", "tech", "science", "self-improvement", "history", "health"
  buyLink               String?  // Affiliate or Amazon link
  rating                Float?   // Average rating from API
  publishedAt           DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([title, author])
  @@index([genre])
  @@index([rating])
}

model Workspace {
  id              String   @id @default(uuid())

  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  roadmapId       String?
  currentDay      Int      @default(1)
  currentMode     Int      @default(1)

  selectedTopicId String?
  topicTitle      String?

  editorContent   String?  @db.Text

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

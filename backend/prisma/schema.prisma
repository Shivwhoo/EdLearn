generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  credits             Int                  @default(15)
  badges              Badge[]
  dataExportRequests  DataExportRequest[]
  passwordResetTokens PasswordResetToken[]
  progress            Progress[]
  refreshTokens       RefreshToken[]
  roadmaps            Roadmap[]
  subscription        Subscription?
  twoFactorSecret     TwoFactorSecret?
  profile             UserProfile?
  visions             Vision[]
  milestones          VisionMilestone[]
  workspace           Workspace?
  studyRooms          StudyRoom[]
  questions           Question[]
  answers             Answer[]
}

/// A single card on a student's personal Vision Board — a learning goal,
/// career ambition or aspiration they want to keep in front of them.
/// Always scoped to one owner; the API never trusts a client-supplied userId.
model Vision {
  id          String            @id @default(uuid())
  userId      String
  title       String
  description String?
  category    String            @default("other")
  imageUrl    String?
  targetDate  DateTime?
  quote       String?
  resourceUrl String?
  status      String            @default("not_started")
  achievedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones  VisionMilestone[]

  @@index([userId])
  @@index([userId, status])
}

model Badge {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?
  badgeType   String
  imageUrl    String?
  earnedAt    DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A single step/milestone on a Vision Board entry's personal roadmap.
/// Stored in the database — NOT localStorage. Scoped to the owner via userId;
/// the API never trusts a client-supplied userId.
model VisionMilestone {
  id          String    @id @default(uuid())
  userId      String
  visionId    String?
  title       String
  description String    @default("")
  targetDate  DateTime?
  sortOrder   Int       @default(0)
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vision      Vision?   @relation(fields: [visionId], references: [id])

  @@index([userId])
  @@index([visionId])
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String?
  careerGoal    String?
  currentSkills String[]
  availableTime Int
  difficulty    String   @default("Intermediate")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id           String   @id @default(uuid())
  userId       String
  title        String
  deadline     DateTime
  isAchievable Boolean  @default(true)
  createdAt    DateTime @default(now())
  days         Day[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Day {
  id        String  @id @default(uuid())
  roadmapId String
  dayNumber Int
  title     String
  duration  Int
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id          String     @id @default(uuid())
  dayId       String
  title       String
  mode        Int
  notesHtml   String
  audioUrl    String?
  audioTiming Json?
  completed   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  citations   Citation[]
  day         Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Citation {
  id        String  @id @default(uuid())
  topicId   String
  label     String
  rawText   String
  sourceUrl String?
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  score       Int      @default(100)
  completedAt DateTime @default(now())
  dayId       String
  roadmapId   String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  stripeId  String   @unique
  status    String
  tier      String   @default("FREE")
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NewsArticle {
  id          String   @id @default(cuid())
  title       String
  description String
  source      String
  url         String   @unique
  imageUrl    String?
  category    String
  publishedAt DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([publishedAt])
}

model MediaContent {
  id           String   @id @default(cuid())
  title        String
  description  String
  thumbnailUrl String
  contentUrl   String   @unique
  contentType  String
  platform     String
  channelName  String
  duration     Int?
  publishedAt  DateTime
  category     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category])
  @@index([contentType])
  @@index([publishedAt])
}

model BookSummary {
  id                    String   @id @default(cuid())
  title                 String
  author                String
  coverImage            String
  description           String
  threeSentenceTakeaway String
  genre                 String
  buyLink               String?
  rating                Float?
  publishedAt           DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([title, author])
  @@index([genre])
  @@index([rating])
}

model Workspace {
  id              String   @id @default(uuid())
  userId          String   @unique
  roadmapId       String?
  currentDay      Int      @default(1)
  currentMode     Int      @default(1)
  selectedTopicId String?
  topicTitle      String?
  editorContent   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Refresh token record for rotation-based session management.
/// Only the SHA-256 hash of the raw token is stored here — never the raw value.
/// Tokens are grouped by `family`; any reuse of a revoked token in a family
/// revokes the ENTIRE family (theft detection).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

/// One-time OTP record for the forgot-password flow.
/// The OTP is hashed (SHA-256) before storage. Expires in 10 minutes and is
/// marked `used` after a successful password reset so it cannot be replayed.
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// TOTP secret for opt-in 2FA.
/// The secret itself should be treated as sensitive (consider encrypting at
/// rest via a KMS key in production). Backup codes are stored as SHA-256 hashes.
/// `enabled` is only set to true after the user confirms a valid TOTP code.
model TwoFactorSecret {
  id          String    @id @default(uuid())
  userId      String    @unique
  secret      String
  backupCodes String[]
  enabled     Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Audit trail for GDPR data-export requests.
model DataExportRequest {
  id          String    @id @default(uuid())
  userId      String
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model StudyRoom {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  questions   Question[]
  whiteboard  WhiteboardState?
}

model WhiteboardState {
  id        String    @id @default(uuid())
  roomId    String    @unique
  content   String    @db.Text
  version   Int       @default(0)
  updatedAt DateTime  @updatedAt
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model Question {
  id        String    @id @default(uuid())
  roomId    String
  authorId  String
  title     String
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  room      StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  answers   Answer[]
}

model Answer {
  id         String    @id @default(uuid())
  questionId String
  authorId   String
  body       String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  question   Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  author     User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  credits      Int           @default(15)
  progress     Progress[]
  roadmaps     Roadmap[]
  subscription Subscription?
  profile      UserProfile?
}

model UserProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String?
  careerGoal    String?
  currentSkills String[]
  availableTime Int
  difficulty    String   @default("Intermediate")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Roadmap {
  id           String   @id @default(uuid())
  userId       String
  title        String
  deadline     DateTime
  isAchievable Boolean  @default(true)
  createdAt    DateTime @default(now())
  days         Day[]
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Day {
  id        String  @id @default(uuid())
  roadmapId String
  dayNumber Int
  title     String
  duration  Int
  roadmap   Roadmap @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics    Topic[]
}

model Topic {
  id          String     @id @default(uuid())
  dayId       String
  title       String
  mode        Int
  notesHtml   String
  audioUrl    String?
  audioTiming Json?
  completed   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  citations   Citation[]
  day         Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
}

model Citation {
  id        String  @id @default(uuid())
  topicId   String
  label     String
  rawText   String
  sourceUrl String?
  topic     Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String   @id @default(uuid())
  userId      String
  topicId     String
  score       Int      @default(0)
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id        String   @id @default(uuid())
  userId    String   @unique
  stripeId  String   @unique
  status    String
  tier      String   @default("FREE")
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

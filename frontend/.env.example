# EdLearn frontend — environment variable reference.
# Copy to .env.local and fill in real values. Never commit a filled-in .env.local file.

# --- Backend proxy (server-side only, used by next.config.ts rewrites) ---
BACKEND_URL=http://localhost:5000

# --- Public API URL (exposed to browser via NEXT_PUBLIC_ prefix) ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# --- Google OAuth (exposed to browser for login button) ---
# Must match the GOOGLE_CLIENT_ID in backend/.env
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

{
  "title": "EdLearn Backend — Starter Dashboard",
  "uid": "edlearn-backend",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_requests_total[5m])) by (route)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 2,
      "title": "5xx error rate (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(http_request_errors_total[5m])) by (route)", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 3,
      "title": "p95 request latency (s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "TTS generation duration (s), by outcome",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(tts_generation_duration_seconds_bucket[5m])) by (le, route, outcome))",
          "legendFormat": "{{route}} - {{outcome}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Process memory (resident, bytes)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "process_resident_memory_bytes", "legendFormat": "backend" }
      ]
    }
  ]
}

diff --git a/backend/prisma/schema.prisma b/backend/prisma/schema.prisma
index d52bef8..e62b556 100644
--- a/backend/prisma/schema.prisma
+++ b/backend/prisma/schema.prisma
@@ -16,11 +16,18 @@ model User {
   roadmaps      Roadmap[]
   milestones    VisionMilestone[]
   progress      Progress[]
+  role          String        @default("USER") // "USER" | "ADMIN" | "MODERATOR"
   credits       Int           @default(15)
   subscription  Subscription?
   workspace     Workspace?
   badges        Badge[]
   visions       Vision[]
+  bookmarks     Bookmark[]
+  quizAttempts  QuizAttempt[]
+  notes         Note[]
+  notifications Notification[]
+  flashcards    Flashcard[]
+  certificates  Certificate[]
   refreshTokens         RefreshToken[]
   passwordResetTokens   PasswordResetToken[]
   twoFactorSecret       TwoFactorSecret?
@@ -115,6 +122,7 @@ model Roadmap {
   isAchievable Boolean  @default(true)
   createdAt    DateTime @default(now())
   days         Day[]
+  certificates Certificate[]
   user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 }
 
@@ -314,3 +322,98 @@ model DataExportRequest {
 
   @@index([userId])
 }
+
+/// Bookmarked resources across Books, Media, News, and Roadmap Topics.
+model Bookmark {
+  id        String   @id @default(uuid())
+  userId    String
+  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  itemType  String   // "book" | "media" | "news" | "topic"
+  itemId    String
+  title     String
+  metadata  Json?
+  createdAt DateTime @default(now())
+
+  @@unique([userId, itemType, itemId])
+  @@index([userId])
+  @@index([userId, itemType])
+}
+
+/// Recorded quiz submissions and scoring history.
+model QuizAttempt {
+  id             String   @id @default(uuid())
+  userId         String
+  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  dayId          String
+  topicId        String?
+  score          Int
+  totalQuestions Int
+  answers        Json
+  createdAt      DateTime @default(now())
+
+  @@index([userId])
+  @@index([userId, dayId])
+}
+
+/// Personal learner notes attached to a roadmap day.
+model Note {
+  id        String   @id @default(uuid())
+  userId    String
+  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  dayId     String
+  topicId   String?
+  content   String   @db.Text
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@unique([userId, dayId])
+  @@index([userId])
+}
+
+/// In-app notifications for achievements, milestones, and updates.
+model Notification {
+  id        String   @id @default(uuid())
+  userId    String
+  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  title     String
+  message   String   @db.Text
+  type      String   @default("info") // "info" | "achievement" | "streak" | "reminder"
+  read      Boolean  @default(false)
+  link      String?
+  createdAt DateTime @default(now())
+
+  @@index([userId])
+  @@index([userId, read])
+}
+
+/// A spaced repetition flashcard for long-term retention.
+model Flashcard {
+  id          String   @id @default(uuid())
+  userId      String
+  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  dayId       String
+  front       String   @db.Text
+  back        String   @db.Text
+  easeFactor  Float    @default(2.5)
+  interval    Int      @default(0)
+  repetitions Int      @default(0)
+  dueDate     DateTime @default(now())
+  createdAt   DateTime @default(now())
+  updatedAt   DateTime @updatedAt
+
+  @@index([userId, dueDate])
+}
+
+/// Official course completion certificate records.
+model Certificate {
+  id          String   @id @default(uuid())
+  userId      String
+  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
+  roadmapId   String
+  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
+  sha256Hash  String   @unique
+  issuedAt    DateTime @default(now())
+
+  @@unique([userId, roadmapId])
+  @@index([sha256Hash])
+}
